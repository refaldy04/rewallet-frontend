# Server only. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Leave empty to use the explicitly labeled demo. Never prefix these with NEXT_PUBLIC_.
BACKEND_URL=
# Demo is enabled in development; opt in explicitly for a production preview.
DEMO_ENABLED=false
# Enable only after the backend atomically verifies PIN and idempotency keys on /transfer.
BACKEND_TRANSFER_SUPPORTS_PIN=false
# Optional endpoints, relative to BACKEND_URL. Must implement the contracts in README.
BACKEND_TRANSACTION_PATH=
BACKEND_CHANGE_PIN_PATH=
BACKEND_RECOVERY_PATH=
BACKEND_RESET_PATH=
